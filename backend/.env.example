ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://somosure:somosure_dev@postgres:5432/somosure
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Supabase (documents storage) - leave blank until provisioned
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=somosure-documents

# Never commit real values. This file documents required vars only.
CORS_ORIGINS=http://localhost:3000, https://somosure-insuarance-ltd.vercel.app

# Error monitoring (optional) - leave blank to disable
SENTRY_DSN=

# SMS dispatch (optional) - leave blank to use the mock dispatcher.
# Sign up at https://account.africastalking.com/auth/register
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# WhatsApp (spec §17). WHATSAPP_VERIFY_TOKEN is a value you choose
# yourself and enter into Meta's App Dashboard when configuring the
# webhook - real regardless of whether a WABA/access token exists yet.
# WHATSAPP_APP_SECRET enables real signature verification once a Meta
# app exists; leave blank in dev. See docs/WHATSAPP.md.
WHATSAPP_VERIFY_TOKEN=somosure-dev-verify-token
WHATSAPP_APP_SECRET=

# Insurance providers: real credentials go here per-provider once supplied.
# Nothing below is fabricated or defaulted to a working value.
BRITAM_API_BASE_URL=
BRITAM_API_KEY=
JUBILEE_API_BASE_URL=
JUBILEE_API_KEY=

# Upload screening for application / financing documents:
#   strict (default, recommended for production) | lenient | off
DOCUMENT_VALIDATION=strict

# Show demo quotes from the mock insurers for categories with no live
# pricing yet (staging/demo only). Leave false in production so those
# categories show "coming soon" and route the customer to an agent.
ALLOW_DEMO_QUOTE_CATEGORIES=false

# Audit trail (who did what, when and why) - see docs/AUDIT_TRAIL.md
AUDIT_ENABLED=true
# Extra comma-separated tables to leave out of change capture
AUDIT_EXCLUDED_TABLES=
# Also record every admin READ request (very detailed). Document opens and exports are always recorded.
AUDIT_LOG_READS=false
AUDIT_LOG_GUEST_REQUESTS=true

# New partner applications (the public "Become a partner" page) alert the team.
# Comma-separated. Leave blank to skip alerts (applications still show in the admin queue).
PARTNER_ALERT_EMAILS=
PARTNER_ALERT_PHONES=

# ---------------------------------------------------------------------------
# Payments - M-Pesa (Safaricom Daraja "M-Pesa Express")
# mock   = built-in simulator. Refused in production unless ALLOW_MOCK_PAYMENTS=true.
# daraja = real M-Pesa. Fill in everything below. Try MPESA_ENV=sandbox first.
# ---------------------------------------------------------------------------
MPESA_MODE=mock
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# CustomerPayBillOnline for a Paybill, CustomerBuyGoodsOnline for a Till number
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Public https address of THIS backend, e.g. https://somosure-backend.onrender.com
MPESA_CALLBACK_BASE_URL=
# A long random string (16+ chars, letters/digits only). It becomes part of the
# callback address Safaricom posts to - generate with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
MPESA_CALLBACK_SECRET=
ALLOW_MOCK_PAYMENTS=false

# ---------------------------------------------------------------------------
# Background jobs (renewal reminders, abandoned-quote recovery, M-Pesa reconciliation)
# ---------------------------------------------------------------------------
SCHEDULER_ENABLED=false
SCHEDULER_TICK_SECONDS=60
# Lets an outside scheduler call POST /api/v1/internal/cron/run (see .github/workflows/scheduler.yml).
# Empty = that endpoint is off. Use a long random value.
CRON_SECRET=
